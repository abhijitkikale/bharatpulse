//@version=5
// BharatPulse Levels
// Draws horizontal levels (spot, max pain, gamma flip, GEX / OI walls, POC, VAH, VAL ...) from text pasted
// out of the BharatPulse dashboard (Options tab > "Levels for TradingView" > Copy).
//
// Input format, one level per line (or separated by ;):   Name=Value
//   Spot=22753
//   Gamma flip=22749
// Lines that do not look like Name=Value (for example the # header line) are ignored.
// Add the indicator to a Nifty / Bank Nifty chart, open its Settings > Inputs, paste, click OK.
indicator("BharatPulse Levels", shorttitle="BP Levels", overlay=true, max_lines_count=100, max_labels_count=100)

txt        = input.text_area("", "Levels (paste from BharatPulse)", tooltip="Paste the text copied from the dashboard. One 'Name=Value' per line.")
lineWidth  = input.int(1, "Line width", minval=1, maxval=4)
extendLeft = input.bool(true, "Extend lines to the left")
labelBars  = input.int(4, "Label distance right of the last bar (bars)", minval=0, maxval=50)
showValue  = input.bool(true, "Show the value in each label")
txtSize    = input.string("small", "Label text size", options=["tiny", "small", "normal"])
showLabels = input.bool(true, "Show labels")

f_color(string name) =>
    s = str.lower(name)
    color c = #8b97a8
    if str.contains(s, "spot")
        c := #e6edf3
    else if str.contains(s, "max pain")
        c := #d4e157
    else if str.contains(s, "flip")
        c := #f5a623
    else if str.contains(s, "oi call")
        c := #ef5b5b
    else if str.contains(s, "oi put")
        c := #2ecc9a
    else if str.contains(s, "gex call")
        c := #ff9f6b
    else if str.contains(s, "gex put")
        c := #66c2ff
    else if str.contains(s, "poc")
        c := #e8c547
    else if str.contains(s, "vah") or str.contains(s, "val")
        c := #b388ff
    c

f_style(string name) =>
    s = str.lower(name)
    string st = line.style_dashed
    if str.contains(s, "poc")
        st := line.style_solid
    else if str.contains(s, "max pain") or str.contains(s, "flip")
        st := line.style_dotted
    st

f_size() =>
    txtSize == "tiny" ? size.tiny : txtSize == "normal" ? size.normal : size.small

var line[]  bpLines  = array.new_line()
var label[] bpLabels = array.new_label()

if barstate.islast
    for l in bpLines
        line.delete(l)
    for b in bpLabels
        label.delete(b)
    array.clear(bpLines)
    array.clear(bpLabels)
    clean = str.replace_all(str.replace_all(txt, "\r", ""), "\n", ";")
    items = str.split(clean, ";")
    for it in items
        parts = str.split(it, "=")
        if array.size(parts) == 2
            nm = str.trim(array.get(parts, 0))
            raw = str.replace_all(str.trim(array.get(parts, 1)), ",", "")
            v = str.tonumber(raw)
            if not na(v) and str.length(nm) > 0
                c = f_color(nm)
                array.push(bpLines, line.new(bar_index - 1, v, bar_index, v, extend = extendLeft ? extend.both : extend.right, color = c, style = f_style(nm), width = lineWidth))
                if showLabels
                    t = showValue ? nm + " " + str.tostring(v, "#.##") : nm
                    array.push(bpLabels, label.new(bar_index + labelBars, v, t, style = label.style_label_left, color = color.new(#0b0f16, 15), textcolor = c, size = f_size()))
