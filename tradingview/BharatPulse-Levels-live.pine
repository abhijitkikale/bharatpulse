//@version=6
// BharatPulse Levels  -  LIVE  (BharatPulse-Levels-live.pine)  = Rev 1 + live levels
// TWO paste boxes in Settings > Inputs:
//   1. "Levels (paste from BharatPulse)"  the end-of-day text from the dashboard, pasted once each evening (exactly as in Rev 1).
//   2. "Live levels (paste from Telegram)"  the message the bot GEXINDICATORBOT sends when a live level moves by a strike or more:
//        Gamma flip, GEX call wall, GEX put wall, OI call wall, OI put wall, Max pain of the CURRENT expiry. Drawn in cyan with the
//        prefix "Live"; the end-of-day lines stay as they are. Paste the newest message over the old one (select all, paste).
// The indicator also works out today's volume levels itself from the chart candles and their volume, every candle (drawn in cyan with
// the prefix "Now"): Now POC / VAH / VAL (today so far), Now VWAP, Now Weekly POC / VAH / VAL (last 5 sessions). Same method as the
// dashboard: bins of 5 points (Nifty) / 10 points (Bank Nifty), each candle's volume spread over its high-low range, 70% value area.
// Use a 1, 3 or 5 minute chart. If the chart has no volume the profile uses candle count instead (the label then says so).
//
// BharatPulse Levels  -  REV 1  (BharatPulse-Levels-rev1.pine)
// Rev 0 (BharatPulse-Levels.pine) draws the CALL / PUT on the close of the retest candle.
// Rev 1 uses the NEXT candle after the retest to decide the direction ("Confirmation candle" setting):
//   * Next candle decides [default]: it closes ABOVE the level = CALL, BELOW the level = PUT.
//       - it closes on the same side as the retest candle  = the level held / price bounced back  -> labelled (bounce)
//       - it closes on the other side                      = price crossed the level              -> labelled (cross)
//   * Next candle must not cross back: keeps the retest candle's direction only if the next candle closes on the same side.
//   * Next candle must close in the signal direction: green candle for CALL, red candle for PUT.
//   * Off: exactly Rev 0.
// The signal is drawn on that next candle and the option strike is taken from ITS close. A small grey x marks a retest that was
// dropped because the next candle did not confirm it. Add Rev 0 and Rev 1 to the same chart to compare them.
// Draws horizontal levels (spot, max pain, gamma flip, GEX / OI walls, POC, VAH, VAL ...) from text pasted out of the
// BharatPulse dashboard (Options tab > "Levels for TradingView" > Copy levels), shows the day's gamma regime in a box at the
// top right, and marks touch > doji > retest setups at the levels.
//
// Input format, one entry per line (or separated by ;):
//   Name=Value     a level, for example   Gamma flip=22749   (Weekly POC / VAH / VAL = the last 5 sessions' profile)
//   ~ text         a regime description line (first one is the title)
//   # text         comment, ignored
//   @pos_above=1  which side of the gamma flip is positive gamma (1 = above); lets the box and labels show a regime change
// The levels are end-of-day numbers: text copied from the 26th close is drawn only on the NEXT trading day (the 27th).
// The date is read from the header line (# ... close 2026-10-26). Before that day starts the lines are shown going forward from the last bar.
// Add the indicator to a Nifty / Bank Nifty chart, open Settings > Inputs, paste into "Levels", press OK.
//
// Strategy (per enabled level):
//   1. a candle touches the level          2. then a doji candle forms at the level
//   3. later a candle retests the level (after price has left it): closes ABOVE = CALL setup, BELOW = PUT setup,
//      it closes BELOW the level = PUT setup. Signals are drawn on the close of the retest candle.
// Information only, not investment advice. Test on your own data before trading it.
indicator("BharatPulse Levels Live", shorttitle="BP Live", overlay=true, max_lines_count=500, max_labels_count=500, max_bars_back=5000)

// ---------------- inputs ----------------
txt = input.text_area("", "Levels (paste from BharatPulse)", tooltip="Paste the end-of-day text copied from the dashboard.")
liveTxt = input.text_area("", "Live levels (paste from Telegram)", tooltip="Paste the newest live message from the Telegram bot here. Replace the old one.")

gShow = "Show / hide lines"
enSpot  = input.bool(true, "Spot", group=gShow)
enPain  = input.bool(true, "Max pain", group=gShow)
enFlip  = input.bool(true, "Gamma flip", group=gShow)
enOiC   = input.bool(true, "OI call wall", group=gShow)
enOiP   = input.bool(true, "OI put wall", group=gShow)
enGexC  = input.bool(true, "GEX call wall", group=gShow)
enGexP  = input.bool(true, "GEX put wall", group=gShow)
enPoc   = input.bool(true, "POC", group=gShow)
enVah   = input.bool(true, "VAH", group=gShow)
enVal   = input.bool(true, "VAL", group=gShow)
enWkPoc = input.bool(true, "Weekly POC (last 5 sessions)", group=gShow)
enWkVah = input.bool(true, "Weekly VAH", group=gShow)
enWkVal = input.bool(true, "Weekly VAL", group=gShow)
enOther = input.bool(true, "Any other level", group=gShow)

gLive = "Live levels"
liveColor  = input.color(#18ffff, "Colour of all live lines", group=gLive)
enNowVol   = input.bool(true, "Work out today's volume levels from the chart (Now POC / VAH / VAL / VWAP / Weekly)", group=gLive)
enNowVwap  = input.bool(true, "Now VWAP", group=gLive)
liveWidth  = input.int(2, "Live line width", minval=1, maxval=4, group=gLive)
showLiveReg = input.bool(true, "Show the live gamma regime box (from the Telegram message)", group=gLive)
liveRegPos  = input.string("Middle right", "Live regime box position", options=["Top left", "Top center", "Top right", "Middle left", "Middle right", "Bottom left", "Bottom center", "Bottom right"], group=gLive)

gLook = "Appearance"
lineWidth  = input.int(1, "Line width", minval=1, maxval=4, group=gLook)
extendLeft = input.bool(true, "Extend lines to the left", group=gLook)
showLabels = input.bool(true, "Show labels", group=gLook)
labelBars  = input.int(3, "Labels: bars to the right of the last candle", minval=0, maxval=50, group=gLook)
labelGap   = input.float(0.0, "Labels: minimum gap in points (0 = automatic)", minval=0.0, step=1.0, group=gLook)
showValue  = input.bool(true, "Show the value in each label", group=gLook)
txtSize    = input.string("small", "Label text size", options=["tiny", "small", "normal"], group=gLook)
showRegime = input.bool(true, "Show the regime box", group=gLook)
regPos     = input.string("Top right", "Regime box position", options=["Top left", "Top center", "Top right", "Middle left", "Middle right", "Bottom left", "Bottom center", "Bottom right"], group=gLook)
boxTransp  = input.int(35, "Boxes: background transparency (0 = solid, 100 = clear)", minval=0, maxval=100, group=gLook)
restrictDay = input.bool(true, "Draw levels and signals only on the trading day AFTER the close date in the pasted text", group=gLook)

gStr = "Touch > doji > retest signals"
useStrat = input.bool(true, "Show CALL / PUT signals", group=gStr)
tolPct   = input.float(0.03, "Touch tolerance (% of the level)", minval=0.0, step=0.01, group=gStr)
dojiPct  = input.float(30.0, "Doji: body at most this % of the candle range", minval=1.0, maxval=60.0, group=gStr)
maxWait  = input.int(12, "Give up after this many bars between the steps", minval=2, maxval=100, group=gStr)
minAway  = input.int(1, "Bars price must leave the level before the retest", minval=0, maxval=20, group=gStr)
sigFrom  = input.time(946684800000, "Show signals from", group=gStr)
confirmMode = input.string("Next candle decides: close above = CALL, close below = PUT", "Confirmation candle (Rev 1)", options=["Off (same as Rev 0)", "Next candle decides: close above = CALL, close below = PUT", "Next candle must not cross back over the level", "Next candle must close in the signal direction"], group=gStr)
showFailed  = input.bool(true, "Mark setups that were not confirmed (grey x)", group=gStr)
strikeIn = input.string("Auto", "Option strike step (Auto = 50 for Nifty, 100 for Bank Nifty)", options=["Auto", "50", "100"], group=gStr)
markOnChart = input.bool(true, "Also mark CALL / PUT on the chart", group=gStr)
showSigBox  = input.bool(true, "Show the setups table", group=gStr)
sigPos      = input.string("Top center", "Setups table position", options=["Top left", "Top center", "Top right", "Middle left", "Middle right", "Bottom left", "Bottom center", "Bottom right"], group=gStr)
sigRows     = input.int(3, "Setups table: most recent setups to list", minval=1, maxval=6, group=gStr)
sigOnlyWhen = input.bool(false, "Show the setups table only when there is a setup", group=gStr)

// ---------------- helpers ----------------
f_enabled(string name) =>
    s = str.lower(name)
    bool e = enOther
    if str.contains(s, "weekly") and str.contains(s, "poc")
        e := enWkPoc
    else if str.contains(s, "weekly") and str.contains(s, "vah")
        e := enWkVah
    else if str.contains(s, "weekly") and str.contains(s, "val")
        e := enWkVal
    else if str.contains(s, "spot")
        e := enSpot
    else if str.contains(s, "max pain")
        e := enPain
    else if str.contains(s, "flip")
        e := enFlip
    else if str.contains(s, "oi call")
        e := enOiC
    else if str.contains(s, "oi put")
        e := enOiP
    else if str.contains(s, "gex call")
        e := enGexC
    else if str.contains(s, "gex put")
        e := enGexP
    else if str.contains(s, "poc")
        e := enPoc
    else if str.contains(s, "vah")
        e := enVah
    else if str.contains(s, "val")
        e := enVal
    e

f_color(string name) =>
    s = str.lower(name)
    color c = #8b97a8
    if str.startswith(s, "live") or str.startswith(s, "now")
        c := liveColor
    else if str.contains(s, "weekly") and str.contains(s, "poc")
        c := #ff80ab
    else if str.contains(s, "weekly") and (str.contains(s, "vah") or str.contains(s, "val"))
        c := #80cbc4
    else if str.contains(s, "spot")
        c := #e6edf3
    else if str.contains(s, "max pain")
        c := #d4e157
    else if str.contains(s, "flip")
        c := #f5a623
    else if str.contains(s, "oi call")
        c := #ef5b5b
    else if str.contains(s, "oi put")
        c := #2ecc9a
    else if str.contains(s, "gex call")
        c := #ff9f6b
    else if str.contains(s, "gex put")
        c := #66c2ff
    else if str.contains(s, "poc")
        c := #e8c547
    else if str.contains(s, "vah") or str.contains(s, "val")
        c := #b388ff
    c

f_style(string name) =>
    s = str.lower(name)
    string st = line.style_dashed
    if str.startswith(s, "now vwap")
        st := line.style_solid
    else if str.contains(s, "weekly")
        st := str.contains(s, "poc") ? line.style_solid : line.style_dotted
    else if str.contains(s, "poc")
        st := line.style_solid
    else if str.contains(s, "max pain") or str.contains(s, "flip")
        st := line.style_dotted
    st

f_pos(string p) =>
    p == "Top left" ? position.top_left : p == "Top center" ? position.top_center : p == "Top right" ? position.top_right :
     p == "Middle left" ? position.middle_left : p == "Middle right" ? position.middle_right : p == "Bottom left" ? position.bottom_left :
     p == "Bottom center" ? position.bottom_center : position.bottom_right

f_size() =>
    txtSize == "tiny" ? size.tiny : txtSize == "normal" ? size.normal : size.small

// ---------------- parse the pasted text once ----------------
var float[]  lv      = array.new_float()
var string[] ln      = array.new_string()
var int[]    stg     = array.new_int()      // 0 idle, 1 touched, 2 doji seen
var int[]    stgBar  = array.new_int()      // bar where the current stage began
var int[]    lvFrom  = array.new_int()      // time from which a level exists (0 = the whole day; live levels: when the message was made)
var string   liveHHMM = ""                  // time of the pasted live message, shown in the labels
var int      liveFromTime = na
var int      liveStartBar = na
var string   liveRegTitle = ""          // the live gamma regime from the Telegram message
var string   liveRegBody  = ""
var int      livePosAbove = na
var float    liveFlip = na
var table    liveRegBox = na
var int[]    awayN   = array.new_int()      // bars spent away from the level since the doji
var string[] pendSide = array.new_string()  // Rev 1: a retest waiting for its confirmation candle (CALL / PUT / empty)
var int[]    pendBar  = array.new_int()     // the bar on which that retest happened
var string   regTitle = ""
var string   regBody  = ""
var float    flipLvl = na              // the gamma flip level from the pasted text
var int      posAboveFlag = na         // 1 = positive gamma applies ABOVE the flip, 0 = positive gamma applies BELOW it
var int      lvStartTime = na         // start of the calendar day after the close date in the pasted header
var int      dayStartBar = na
var int      dayEndBar   = na
var int      dayKey      = na
var string[] sgWhen   = array.new_string()   // newest first: when, side, strike, level of each setup
var string[] sgSide   = array.new_string()
var string[] sgStrike = array.new_string()
var string[] sgLevel  = array.new_string()

if barstate.isfirst
    clean = str.replace_all(str.replace_all(txt, "\r", ""), "\n", ";")
    items = str.split(clean, ";")
    for it in items
        t = str.trim(it)
        if str.length(t) > 0 and not str.startswith(t, "#")
            if str.startswith(t, "@")
                ap = str.split(t, "=")
                if array.size(ap) == 2 and str.lower(str.trim(array.get(ap, 0))) == "@pos_above"
                    posAboveFlag := int(str.tonumber(str.trim(array.get(ap, 1))))
            else if str.startswith(t, "~")
                body = str.trim(str.substring(t, 1))
                if regTitle == ""
                    regTitle := body
                else
                    regBody := regBody == "" ? body : regBody + "\n" + body
            else
                parts = str.split(t, "=")
                if array.size(parts) == 2
                    nm = str.trim(array.get(parts, 0))
                    raw = str.replace_all(str.trim(array.get(parts, 1)), ",", "")
                    v = str.tonumber(raw)
                    if not na(v) and str.contains(str.lower(nm), "flip") and not str.contains(str.lower(nm), "weekly")
                        flipLvl := v
                    if not na(v) and str.length(nm) > 0 and f_enabled(nm)
                        array.push(lv, v)
                        array.push(ln, nm)
                        array.push(stg, 0)
                        array.push(stgBar, 0)
                        array.push(lvFrom, 0)
                        array.push(awayN, 0)
                        array.push(pendSide, "")
                        array.push(pendBar, 0)

    // ---- the live box: same Name=Value lines, every name gets the prefix "Live " ----
    lp = str.pos(liveTxt, "LIVE 20")
    if not na(lp)
        lds = str.substring(liveTxt, lp + 5, lp + 15)
        lhh = str.tonumber(str.substring(liveTxt, lp + 16, lp + 18))
        lmm = str.tonumber(str.substring(liveTxt, lp + 19, lp + 21))
        lyy = str.tonumber(str.substring(lds, 0, 4))
        lmo = str.tonumber(str.substring(lds, 5, 7))
        ldd = str.tonumber(str.substring(lds, 8, 10))
        if not na(lyy) and not na(lmo) and not na(ldd) and not na(lhh) and not na(lmm)
            liveFromTime := timestamp(syminfo.timezone, int(lyy), int(lmo), int(ldd), int(lhh), int(lmm))
            liveHHMM := str.substring(liveTxt, lp + 16, lp + 21)
    lclean = str.replace_all(str.replace_all(liveTxt, "\r", ""), "\n", ";")
    litems = str.split(lclean, ";")
    for it in litems
        t = str.trim(it)
        if str.startswith(t, "~")
            lbody = str.trim(str.substring(t, 1))
            if liveRegTitle == ""
                liveRegTitle := lbody
            else
                liveRegBody := liveRegBody == "" ? lbody : liveRegBody + "\n" + lbody
        else if str.startswith(t, "@pos_above")
            lap = str.split(t, "=")
            if array.size(lap) == 2
                livePosAbove := int(str.tonumber(str.trim(array.get(lap, 1))))
        else if str.length(t) > 0 and not str.startswith(t, "#") and not str.startswith(t, "@")
            parts = str.split(t, "=")
            if array.size(parts) == 2
                nm = "Live " + str.trim(array.get(parts, 0))
                raw = str.replace_all(str.trim(array.get(parts, 1)), ",", "")
                v = str.tonumber(raw)
                if not na(v) and str.contains(str.lower(nm), "flip")
                    liveFlip := v
                if not na(v) and f_enabled(nm)
                    array.push(lv, v)
                    array.push(ln, nm)
                    array.push(stg, 0)
                    array.push(stgBar, 0)
                    array.push(lvFrom, na(liveFromTime) ? 0 : liveFromTime)
                    array.push(awayN, 0)
                    array.push(pendSide, "")
                    array.push(pendBar, 0)

    cp = str.pos(txt, "close 20")
    if not na(cp)
        ds = str.substring(txt, cp + 6, cp + 16)
        yy = str.tonumber(str.substring(ds, 0, 4))
        mm = str.tonumber(str.substring(ds, 5, 7))
        dd = str.tonumber(str.substring(ds, 8, 10))
        if not na(yy) and not na(mm) and not na(dd)
            lvStartTime := timestamp(syminfo.timezone, int(yy), int(mm), int(dd), 0, 0) + 86400000

// the trading day the levels are for: the first session after the close date (EOD 26th -> 27th)
int dayKeyNow = year * 10000 + month * 100 + dayofmonth
if restrictDay and not na(lvStartTime)
    if na(dayStartBar) and time >= lvStartTime
        dayStartBar := bar_index
        dayKey := dayKeyNow
    if not na(dayStartBar) and dayKeyNow == dayKey
        dayEndBar := bar_index
if na(liveStartBar) and not na(liveFromTime) and time >= liveFromTime
    liveStartBar := bar_index
flipXUp = ta.crossover(close, flipLvl)
flipXDn = ta.crossunder(close, flipLvl)
bool inDay = not restrictDay or na(lvStartTime) or (not na(dayStartBar) and dayKeyNow == dayKey)

// regime change: the close crosses the gamma flip
bool flipCross = (flipXUp or flipXDn) and not na(flipLvl) and not na(posAboveFlag) and inDay
if flipCross and barstate.isconfirmed
    bool posAfter = flipXUp ? posAboveFlag == 1 : posAboveFlag != 1
    label.new(bar_index, flipXUp ? low : high, (posAfter ? "POSITIVE" : "NEGATIVE") + " gamma regime\nflip " + str.tostring(flipLvl, "#.##") + (flipXUp ? " crossed up" : " crossed down"), style = flipXUp ? label.style_label_up : label.style_label_down, color = posAfter ? #2ecc9a : #ef5b5b, textcolor = color.white, size = size.small)
alertcondition(flipCross, "BharatPulse gamma flip crossed", "BharatPulse: price crossed the gamma flip on {{ticker}} (regime changed)")

autoGap = (ta.highest(high, 200) - ta.lowest(low, 200)) / 32.0
// option strike = the retest candle's close rounded to the nearest 50 (Nifty) or 100 (Bank Nifty)
bool isBank = str.contains(str.upper(syminfo.ticker), "BANK") or str.contains(str.upper(regTitle), "BANK NIFTY")
float strikeStep = strikeIn == "Auto" ? (isBank ? 100.0 : 50.0) : str.tonumber(strikeIn)

// ---------------- touch > doji > retest ----------------
bool callAny = false
bool putAny = false
isDoji = (high - low) > 0 and math.abs(close - open) <= (high - low) * dojiPct / 100.0
bool confirmOn = confirmMode != "Off (same as Rev 0)"
bool decides = confirmMode == "Next candle decides: close above = CALL, close below = PUT"
if useStrat and barstate.isconfirmed and inDay and time >= sigFrom and array.size(lv) > 0
    for i = 0 to array.size(lv) - 1
        L = array.get(lv, i)
        tl = L * tolPct / 100.0
        touching = high >= L - tl and low <= L + tl and time >= array.get(lvFrom, i)
        string emitSide = ""
        string emitTag = ""
        // Rev 1: this candle is the confirmation candle for a retest that happened on the previous candle
        string ps = array.get(pendSide, i)
        if ps != ""
            if bar_index == array.get(pendBar, i) + 1
                if decides
                    emitSide := close > L ? "CALL" : close < L ? "PUT" : ""
                    emitTag := emitSide == "" or ps == "EQ" ? "" : emitSide == ps ? " (bounce)" : " (cross)"
                else
                    bool ok = confirmMode == "Next candle must close in the signal direction" ? (ps == "CALL" ? close > open : close < open) : (ps == "CALL" ? close > L : close < L)
                    if ok
                        emitSide := ps
                    else if showFailed
                        label.new(bar_index, ps == "CALL" ? low : high, "x", style = ps == "CALL" ? label.style_label_up : label.style_label_down, color = color.new(#8b97a8, 30), textcolor = color.white, size = size.tiny)
            array.set(pendSide, i, "")
        s = array.get(stg, i)
        if s > 0 and bar_index - array.get(stgBar, i) > maxWait
            s := 0
            array.set(stg, i, 0)
        if s == 0
            if touching
                array.set(stg, i, 1)
                array.set(stgBar, i, bar_index)
        else if s == 1
            if touching and isDoji and bar_index > array.get(stgBar, i)
                array.set(stg, i, 2)
                array.set(stgBar, i, bar_index)
                array.set(awayN, i, 0)
        else if s == 2
            if touching
                if array.get(awayN, i) >= minAway
                    string side = close > L ? "CALL" : close < L ? "PUT" : ""
                    if decides
                        array.set(pendSide, i, side == "" ? "EQ" : side)      // the next candle decides, even if the retest closed exactly on the level
                        array.set(pendBar, i, bar_index)
                    else if side != ""
                        if confirmOn
                            array.set(pendSide, i, side)
                            array.set(pendBar, i, bar_index)
                        else
                            emitSide := side
                    array.set(stg, i, 0)
            else
                array.set(awayN, i, array.get(awayN, i) + 1)
        if emitSide != ""
            nm = array.get(ln, i)
            callAny := callAny or emitSide == "CALL"
            putAny := putAny or emitSide == "PUT"
            strike = math.round(close / strikeStep) * strikeStep
            array.unshift(sgWhen, str.format_time(time, "dd MMM HH:mm", syminfo.timezone))
            array.unshift(sgSide, emitSide)
            array.unshift(sgStrike, str.tostring(strike, "#"))
            array.unshift(sgLevel, nm + " " + str.tostring(L, "#.##") + emitTag)
            if array.size(sgWhen) > 6
                array.pop(sgWhen)
                array.pop(sgSide)
                array.pop(sgStrike)
                array.pop(sgLevel)
            if markOnChart
                if emitSide == "CALL"
                    label.new(bar_index, low, confirmOn ? "CALL ✓" + emitTag : "CALL", style=label.style_label_up, color=#2ecc9a, textcolor=color.white, size=size.small)
                else
                    label.new(bar_index, high, confirmOn ? "PUT ✓" + emitTag : "PUT", style=label.style_label_down, color=#ef5b5b, textcolor=color.white, size=size.small)

alertcondition(callAny, "BharatPulse CALL setup", "BharatPulse: CALL setup (touch, doji, retest closed above the level) on {{ticker}}")
alertcondition(putAny, "BharatPulse PUT setup", "BharatPulse: PUT setup (touch, doji, retest closed below the level) on {{ticker}}")

// ---------------- volume levels worked out from the chart candles (same method as the dashboard) ----------------
// nb = number of most recent candles to use (index 0 = the latest). Returns [POC, VAH, VAL, 1 if the chart had volume else 0].
f_prof(int nb, float binSz) =>
    float mn = 1.0e12
    float mx = 0.0
    float tvol = 0.0
    for i = 0 to nb - 1
        mn := math.min(mn, low[i])
        mx := math.max(mx, high[i])
        tvol += nz(volume[i])
    bool useVol = tvol > 0
    float base = math.floor(mn / binSz) * binSz
    float top = math.max(math.ceil(mx / binSz) * binSz, base + binSz)
    int n = int(math.round((top - base) / binSz))
    float[] vol = array.new_float(n, 0.0)
    for i = 0 to nb - 1
        float a = low[i]
        float b = high[i]
        float w = useVol ? nz(volume[i]) : 1.0
        if b - a < 1.0e-9
            int k = math.min(math.max(int(math.floor((a - base) / binSz)), 0), n - 1)
            array.set(vol, k, array.get(vol, k) + w)
        else
            int k0 = math.max(int(math.floor((a - base) / binSz)), 0)
            int k1 = math.min(int(math.floor((b - base) / binSz)), n - 1)
            for k = k0 to k1
                float ov = math.min(b, base + (k + 1) * binSz) - math.max(a, base + k * binSz)
                if ov > 0
                    array.set(vol, k, array.get(vol, k) + w * ov / (b - a))
    float total = array.sum(vol)
    int poc = array.indexof(vol, array.max(vol))
    float target = 0.7 * total
    int loI = poc
    int hiI = poc
    float acc = array.get(vol, poc)
    bool go = total > 0
    while go
        bool hasUp = hiI + 1 < n
        bool hasDn = loI - 1 >= 0
        if not hasUp and not hasDn
            go := false
        else
            float up = hasUp ? array.get(vol, hiI + 1) : -1.0
            float dn = hasDn ? array.get(vol, loI - 1) : -1.0
            bool takeUp = not hasDn or (hasUp and up >= dn)
            float cand = takeUp ? up : dn
            if acc + cand > target
                go := false
            else
                acc += cand
                if takeUp
                    hiI += 1
                else
                    loI -= 1
    [base + (poc + 0.5) * binSz, base + (hiI + 1) * binSz, base + loI * binSz, useVol ? 1.0 : 0.0]

float vwapNow = ta.vwap(hlc3)
float nowPoc = na
float nowVah = na
float nowVal = na
float wkPoc = na
float wkVah = na
float wkVal = na
float volFlag = 1.0
int nToday = -1                      // candles in today's session
int nWeek = 0                        // candles in the last 5 sessions
if barstate.islast and timeframe.isintraday
    int dcount = 0
    int pk = -1
    int maxI = math.min(bar_index, 4999)
    for i = 0 to maxI
        int kk = int(math.floor(time[i] / 86400000))
        if kk != pk
            dcount += 1
            pk := kk
            if dcount == 2
                nToday := i
            if dcount == 6
                break
        nWeek := i + 1
    if nToday < 0
        nToday := nWeek
    if enNowVol and nToday > 0
        float binSz = isBank ? 10.0 : 5.0
        [p1, h1, l1, vf] = f_prof(nToday, binSz)
        nowPoc := p1
        nowVah := h1
        nowVal := l1
        volFlag := vf
        [p5, h5, l5, vf5] = f_prof(nWeek, binSz)
        wkPoc := p5
        wkVah := h5
        wkVal := l5

// ---------------- draw levels, stacked labels, regime box (last bar only) ----------------
var line[]  bpLines  = array.new_line()
var label[] bpLabels = array.new_label()
var table   sigBox   = na
var table   regBox   = na

if barstate.islast
    for l in bpLines
        line.delete(l)
    for b in bpLabels
        label.delete(b)
    array.clear(bpLines)
    array.clear(bpLabels)
    // draw list = every pasted level plus the levels worked out from the chart
    float[]  dLv = array.copy(lv)
    string[] dNm = array.copy(ln)
    string sfx = volFlag > 0 ? "" : " (no volume: candle count)"
    if enNowVol and not na(nowPoc)
        if enPoc
            array.push(dLv, nowPoc)
            array.push(dNm, "Now POC" + sfx)
        if enVah
            array.push(dLv, nowVah)
            array.push(dNm, "Now VAH")
        if enVal
            array.push(dLv, nowVal)
            array.push(dNm, "Now VAL")
        if enWkPoc
            array.push(dLv, wkPoc)
            array.push(dNm, "Now Weekly POC")
        if enWkVah
            array.push(dLv, wkVah)
            array.push(dNm, "Now Weekly VAH")
        if enWkVal
            array.push(dLv, wkVal)
            array.push(dNm, "Now Weekly VAL")
    if enNowVwap and not na(vwapNow)
        array.push(dLv, vwapNow)
        array.push(dNm, "Now VWAP")
    n = array.size(dLv)
    if n > 0
        gap = labelGap > 0 ? labelGap : autoGap
        idx = array.sort_indices(dLv, order.descending)
        float prev = na
        int xs = bar_index - 1
        int xe = bar_index
        string ext = extendLeft ? extend.both : extend.right
        int lx = bar_index + labelBars
        if restrictDay and not na(lvStartTime)
            if na(dayStartBar)
                ext := extend.right                      // the chart has not reached that session yet: preview the lines going forward
            else
                xs := dayStartBar
                xe := math.max(dayEndBar, dayStartBar + 1)
                ext := dayEndBar == bar_index ? extend.right : extend.none
                lx := xe + labelBars
        for k = 0 to n - 1
            i = array.get(idx, k)
            v = array.get(dLv, i)
            nm = array.get(dNm, i)
            c = f_color(nm)
            string lname = str.lower(nm)
            bool isLiveLine = str.startswith(lname, "live")
            bool isNowLine = str.startswith(lname, "now")
            // live lines start when the message was made, "Now" lines at the start of today's session; the end-of-day lines keep their window
            int lxs = isLiveLine ? (na(liveStartBar) ? bar_index - 1 : liveStartBar) : isNowLine ? bar_index - math.max(nToday, 1) : xs
            int lxe = (isLiveLine or isNowLine) ? bar_index : xe
            string lext = (isLiveLine or isNowLine) ? extend.right : ext
            int llx = (isLiveLine or isNowLine) ? bar_index + labelBars : lx
            int lw = (isLiveLine or isNowLine) ? liveWidth : lineWidth
            array.push(bpLines, line.new(lxs, v, lxe, v, extend = lext, color = c, style = f_style(nm), width = lw))
            y = na(prev) ? v : math.min(v, prev - gap)       // two labels at one level sit one below the other
            prev := y
            if showLabels
                tx = showValue ? nm + " " + str.tostring(v, "#.##") : nm
                if isLiveLine and liveHHMM != ""
                    tx := tx + "  " + liveHHMM
                array.push(bpLabels, label.new(llx, y, tx, style = label.style_label_left, color = color.new(#0b0f16, 15), textcolor = c, size = f_size()))
    if not na(regBox)
        table.delete(regBox)
        regBox := na
    if not na(sigBox)
        table.delete(sigBox)
        sigBox := na
    if not na(liveRegBox)
        table.delete(liveRegBox)
        liveRegBox := na
    if showLiveReg and liveRegTitle != ""
        liveRegBox := table.new(f_pos(liveRegPos), 1, 3, bgcolor=color.new(#0b0f16, boxTransp), border_width=1, border_color=liveColor, frame_width=1, frame_color=liveColor)
        ltc = str.contains(str.upper(liveRegTitle), "POSITIVE") ? #2ecc9a : str.contains(str.upper(liveRegTitle), "NEGATIVE") ? #ef5b5b : #e6edf3
        table.cell(liveRegBox, 0, 0, liveRegTitle + (liveHHMM != "" ? "  " + liveHHMM : ""), width = 28, text_color = ltc, text_halign = text.align_left, text_size = size.small)
        table.cell(liveRegBox, 0, 1, liveRegBody, width = 28, text_color = #c9d1d9, text_halign = text.align_left, text_size = size.tiny)
        if not na(liveFlip) and not na(livePosAbove)
            aboveL = close > liveFlip
            posL = aboveL == (livePosAbove == 1)
            lPos = str.contains(str.upper(liveRegTitle), "POSITIVE")
            lNeg = str.contains(str.upper(liveRegTitle), "NEGATIVE")
            changedL = (lPos and not posL) or (lNeg and posL)
            table.cell(liveRegBox, 0, 2, "Now: price " + (aboveL ? "above" : "below") + " the live gamma flip " + str.tostring(liveFlip, "#.##") + ", so the " + (posL ? "POSITIVE" : "NEGATIVE") + " gamma side applies" + (changedL ? " (REGIME CHANGED since the message)" : ""), width = 28, text_color = posL ? #2ecc9a : #ef5b5b, text_halign = text.align_left, text_size = size.tiny)
    if showRegime and regTitle != ""
        regBox := table.new(f_pos(regPos), 1, 3, bgcolor=color.new(#0b0f16, boxTransp), border_width=1, border_color=#263040, frame_width=1, frame_color=#263040)
        tc = str.contains(str.upper(regTitle), "POSITIVE") ? #2ecc9a : str.contains(str.upper(regTitle), "NEGATIVE") ? #ef5b5b : #e6edf3
        table.cell(regBox, 0, 0, regTitle, width = 28, text_color = tc, text_halign = text.align_left, text_size = size.small)
        table.cell(regBox, 0, 1, regBody, width = 28, text_color = #c9d1d9, text_halign = text.align_left, text_size = size.tiny)
        if not na(flipLvl) and not na(posAboveFlag)
            aboveNow = close > flipLvl
            posNow = aboveNow == (posAboveFlag == 1)
            titlePos = str.contains(str.upper(regTitle), "POSITIVE")
            titleNeg = str.contains(str.upper(regTitle), "NEGATIVE")
            changed = (titlePos and not posNow) or (titleNeg and posNow)
            table.cell(regBox, 0, 2, "Now: price " + (aboveNow ? "above" : "below") + " the gamma flip " + str.tostring(flipLvl, "#.##") + ", so the " + (posNow ? "POSITIVE" : "NEGATIVE") + " gamma side applies" + (changed ? " (REGIME CHANGED since the close)" : ""), width = 28, text_color = posNow ? #2ecc9a : #ef5b5b, text_halign = text.align_left, text_size = size.tiny)
    ns = array.size(sgWhen)
    if showSigBox and useStrat and (ns > 0 or not sigOnlyWhen)
        nr = math.min(ns, sigRows)
        sigBox := table.new(f_pos(sigPos), 4, math.max(nr, 1) + 1, bgcolor=color.new(#0b0f16, boxTransp), border_width=1, border_color=#263040, frame_width=1, frame_color=#263040)
        table.cell(sigBox, 0, 0, confirmOn ? "Confirmed" : "Setup", text_color = #8b97a8, text_halign = text.align_left, text_size = size.tiny)
        table.cell(sigBox, 1, 0, "Buy", text_color = #8b97a8, text_halign = text.align_left, text_size = size.tiny)
        table.cell(sigBox, 2, 0, "Strike", text_color = #8b97a8, text_halign = text.align_left, text_size = size.tiny)
        table.cell(sigBox, 3, 0, "At level", text_color = #8b97a8, text_halign = text.align_left, text_size = size.tiny)
        if nr == 0
            table.cell(sigBox, 0, 1, "No setup yet", text_color = #8b97a8, text_halign = text.align_left, text_size = size.tiny)
        else
            for r = 0 to nr - 1
                sc = array.get(sgSide, r) == "CALL" ? #2ecc9a : #ef5b5b
                table.cell(sigBox, 0, r + 1, array.get(sgWhen, r), text_color = #c9d1d9, text_halign = text.align_left, text_size = size.tiny)
                table.cell(sigBox, 1, r + 1, array.get(sgSide, r), text_color = sc, text_halign = text.align_left, text_size = size.tiny)
                table.cell(sigBox, 2, r + 1, array.get(sgStrike, r) + (array.get(sgSide, r) == "CALL" ? " CE" : " PE"), text_color = sc, text_halign = text.align_left, text_size = size.tiny)
                table.cell(sigBox, 3, r + 1, array.get(sgLevel, r), text_color = #c9d1d9, text_halign = text.align_left, text_size = size.tiny)
